# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API. Only the anon (public) key belongs in the client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude API — used server-side only (Supabase Edge Function) for food-photo
# recognition in Phase 2. Never ship a provider key in the mobile bundle.
# ANTHROPIC_API_KEY=sk-ant-...
