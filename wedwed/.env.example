# ─── База данных (PostgreSQL) ───────────────────────────────────────────────
# DATABASE_URL — рантайм (для Supabase: строка "Transaction pooler", порт 6543,
#                с параметром ?pgbouncer=true&connection_limit=1)
# DIRECT_URL   — миграции/db push (для Supabase: "Direct connection", порт 5432)
#
# Локально (docker-compose) обе можно указать одинаковыми:
DATABASE_URL="postgresql://wedwed:wedwed@localhost:5432/wedwed?schema=public&connection_limit=20&pool_timeout=20"
DIRECT_URL="postgresql://wedwed:wedwed@localhost:5432/wedwed?schema=public"

# ─── Секрет для подписи сессий админки (JWT) ────────────────────────────────
# Сгенерируйте: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ─── Логин админки ──────────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
# Хэш пароля bcrypt. Сгенерируйте свой: npm run hash "ваш-пароль"
# (значение ниже соответствует паролю "admin123" — ОБЯЗАТЕЛЬНО смените!)
ADMIN_PASSWORD_HASH="JDJhJDEwJG0wZ0tXSXpscXBybGJJWkNiUml4dnVWZkF0TGtWMVJNSDdVQlZkaE5DTUFsQm5oamJzSGgy"

# ─── Telegram Bot (для валидации Mini App initData) ─────────────────────────
# Токен бота из @BotFather. Нужен, чтобы проверять подлинность запросов из Telegram.
TELEGRAM_BOT_TOKEN=""

# Публичный адрес приложения (для мета-тегов и ссылок)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
